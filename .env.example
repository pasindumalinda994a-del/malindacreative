# Required — local Docker: mongodb://127.0.0.1:27017/malindacreative
# Or paste your MongoDB Atlas connection string.
MONGODB_URL=mongodb://127.0.0.1:27017/malindacreative

# Required — long random string for Payload auth/encryption.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public site URL (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional — add when Vercel Blob is connected. Without it, media stays local in /media.
# BLOB_READ_WRITE_TOKEN=
